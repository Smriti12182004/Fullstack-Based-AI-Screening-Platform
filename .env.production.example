APP_NAME=AI Screening Platform API
APP_VERSION=0.1.0
DEBUG=false

DATABASE_URL=REPLACE_WITH_SUPABASE_POSTGRESQL_URL
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b

SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER
SMTP_FROM_NAME=AI Screening Platform

BACKEND_BASE_URL=http://YOUR_EC2_PUBLIC_IP/api
FRONTEND_BASE_URL=http://YOUR_EC2_PUBLIC_IP
